# demo: todas as telas e dados ilustrativos funcionam sem o back-end
# backend: login/cadastro reais e listagem/cadastro/edição de eventos via Spring Boot
VITE_API_MODE=demo
# /api funciona com o proxy do Vite para http://127.0.0.1:8080
VITE_API_BASE=/api
# Ferramenta de navegação pelas 63 telas da referência; desativada na interface padrão.
VITE_SHOW_PROTOTYPE_NAV=false
